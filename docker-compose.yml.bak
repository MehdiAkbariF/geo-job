services:
  postgres:
    image: postgis/postgis:16-3.4
    container_name: spatijob_postgres
    restart: unless-stopped
    environment:
      POSTGRES_DB: map_platform
      POSTGRES_USER: map_user
      POSTGRES_PASSWORD: map_password
    ports:
      - "5433:5432"
    volumes:
      - postgis_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U map_user -d map_platform"]
      interval: 5s
      timeout: 5s
      retries: 5
    networks:
      - spatijob_network

  map-api:
    image: ghcr.io/mehdiakbarif/spatijob-map-api:latest
    container_name: spatijob_map_api
    restart: unless-stopped
    environment:
      DATABASE_URL: postgres://map_user:map_password@postgres:5432/map_platform
      RUST_LOG: map_api=info,tower_http=info
    ports:
      - "8080:8080"
    depends_on:
      postgres:
        condition: service_healthy
    networks:
      - spatijob_network

  biz-api:
    image: ghcr.io/mehdiakbarif/spatijob-biz-api:latest
    container_name: spatijob_biz_api
    restart: unless-stopped
    environment:
      DATABASE_URL: postgres://map_user:map_password@postgres:5432/map_platform
      JWT_SECRET: spatijob-super-secret-jwt-key-change-in-production
      RUST_LOG: biz_api=info,tower_http=info
    ports:
      - "8081:8081"
    depends_on:
      postgres:
        condition: service_healthy
    networks:
      - spatijob_network


  web:
    image: ghcr.io/mehdiakbarif/spatijob-web:latest
    container_name: spatijob_web
    restart: unless-stopped
    ports:
      - "80:80"
    depends_on:
      - biz-api
      - map-api
    networks:
      - spatijob_network

volumes:
  postgis_data:

networks:
  spatijob_network:
    driver: bridge
